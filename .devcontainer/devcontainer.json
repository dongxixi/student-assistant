{
  "name": "Student Assistant",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "forwardPorts": [8000, 6080],
  "portsAttributes": {
    "8000": {
      "label": "学管助手",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "邮箱浏览器",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install playwright && .venv/bin/playwright install --with-deps chromium"
}
